<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Onboarding Portal Access</label>
    <description>Full CRUD on onboarding objects + access to Apex classes and the progress tracker LWC.</description>

    <objectPermissions>
        <object>Employee__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Onboarding_Task__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Onboarding_Template__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Template_Task__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Document__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>true</allowDelete>
        <viewAllRecords>true</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <fieldPermissions><field>Employee__c.Manager__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <fieldPermissions><field>Document__c.Document_Type__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <classAccesses><apexClass>OnboardingTaskGenerator</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>OnboardingTaskTriggerHandler</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>StatusRollupService</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>OnboardingEmailService</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>OnboardingReminderScheduler</apexClass><enabled>true</enabled></classAccesses>
    <classAccesses><apexClass>OnboardingProgressController</apexClass><enabled>true</enabled></classAccesses>
</PermissionSet>
